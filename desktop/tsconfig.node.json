{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@dsc/runtime": ["../lib/index.js"],
      "@dsc/runtime/*": ["../lib/*"]
    }
  },
  "include": ["electron/**/*.ts", "electron.vite.config.ts"]
}
